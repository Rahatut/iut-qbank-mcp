# ── Environment ────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qbank
POSTGRES_USER=qbank
POSTGRES_PASSWORD=changeme

# ── Qdrant ──────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_ACTIVE_COLLECTION=iut_qbank_chunks_v1

# ── Object Storage ──────────────────────────────────────────────────────────────
# Backend: local | s3 | minio
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
STORAGE_BUCKET=qbank-documents
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Embedding ───────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# ── MCP Transport ───────────────────────────────────────────────────────────────
# Transport: stdio | http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── Ingestion ───────────────────────────────────────────────────────────────────
DSPACE_BASE_URL=https://dspace.iutoic-dhaka.net
DSPACE_API_VERSION=7
INGESTION_MAX_CONCURRENT_DOWNLOADS=4
INGESTION_DOWNLOAD_TIMEOUT_SECS=120
OCR_ENABLED=true
OCR_LANGUAGE=eng

# ── Multi-tenancy ───────────────────────────────────────────────────────────────
# See DEV-052 for future multi-university support
TENANT_ID=IUT
